{
  "name": "lifequest",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "author": "Umair",
  "description": "Gamified Habit & Task Tracker",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint src worker/src eslint.config.js vite.config.js postcss.config.js tailwind.config.js",
    "test": "vitest run src tools worker",
    "validate:production-env": "node tools/validate-production-env.mjs",
    "validate:dashboard-alignment": "python tools/validate_dashboard_alignment.py",
    "preview": "vite preview",
    "action:dev": "wrangler dev --config worker/wrangler.jsonc",
    "action:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "action:types": "wrangler types --config worker/wrangler.jsonc worker/worker-configuration.d.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "firebase": "^12.16.0",
    "framer-motion": "^12.27.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.17",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^2.1.9",
    "wrangler": "4.20.0"
  }
}
